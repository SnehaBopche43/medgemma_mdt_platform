# MedGemma MDT Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google API Key for MedGemma (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Database Path (optional, defaults to data/medgemma_mdt.db)
DATABASE_PATH=data/medgemma_mdt.db

# Application Settings
APP_ENV=development
