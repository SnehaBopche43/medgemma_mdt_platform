# ============================================================================
# MedGemma MDT Platform - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to GitHub (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# Hugging Face Configuration
# ----------------------------------------------------------------------------
# Get your API token from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# MedGemma Model from Hugging Face
MEDGEMMA_MODEL_NAME=google/medgemma-2b
# Alternative models:
# MEDGEMMA_MODEL_NAME=google/medgemma-7b
# MEDGEMMA_MODEL_NAME=google/medgemma-12b

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# SQLite (default - no setup required)
DATABASE_URL=sqlite:///mdt_platform.db

# PostgreSQL (optional - for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/mdt_platform

# ----------------------------------------------------------------------------
# Security & Privacy Settings
# ----------------------------------------------------------------------------
# Enable/disable PHI (Protected Health Information) redaction
ENABLE_PHI_REDACTION=true

# Secret key for session management (generate a random string)
SECRET_KEY=your_secret_key_here_change_this_in_production

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Enable debug mode (set to false in production)
DEBUG_MODE=false

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=logs/mdt_platform.log

# ----------------------------------------------------------------------------
# Output Settings
# ----------------------------------------------------------------------------
# Directory for generated MDT case briefs
OUTPUT_DIRECTORY=mdt_outputs

# Default export format: pdf, docx, markdown
DEFAULT_EXPORT_FORMAT=pdf

# ----------------------------------------------------------------------------
# MedGemma Model Settings
# ----------------------------------------------------------------------------
# Temperature for MedGemma (0.0-1.0, lower = more consistent)
MEDGEMMA_TEMPERATURE=0.1

# Maximum retries for failed API calls
MEDGEMMA_MAX_RETRIES=3

# Timeout for API calls (in seconds)
MEDGEMMA_TIMEOUT=30
